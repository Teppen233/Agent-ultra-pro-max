# ReviewCrew 环境变量配置
# 复制此文件为 .env 并填入实际值

# ---- LLM 配置 (OpenAI 兼容端点，默认智谱 GLM 系列) ----
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL_NAME=glm-4-flash
LLM_API_KEY=your-api-key-here

# ---- GitHub 配置 (公开仓库可选) ----
GITHUB_TOKEN=

# ---- 运行参数 ----
# 全局超时（秒），默认 600
REVIEWCREW_GLOBAL_TIMEOUT_SECONDS=600
# PR/Diff 加载超时
REVIEWCREW_PR_LOAD_TIMEOUT_SECONDS=30
# 上下文构建超时
REVIEWCREW_CONTEXT_TIMEOUT_SECONDS=90
# 专家审查超时
REVIEWCREW_EXPERT_TIMEOUT_SECONDS=300
# 验证超时
REVIEWCREW_VERIFIER_TIMEOUT_SECONDS=120
# 报告生成超时
REVIEWCREW_REPORT_TIMEOUT_SECONDS=30

# ---- 并发 ----
REVIEWCREW_MAX_CONCURRENT_EXPERTS=3

# ---- 运行目录 ----
REVIEWCREW_RUNS_DIR=runs
